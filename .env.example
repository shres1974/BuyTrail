# Local development only. Never commit real secrets.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://buytrail:local_only@localhost:5432/buytrail
TEST_DATABASE_URL=postgresql://buytrail:local_only@localhost:5432/buytrail_test
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace_with_a_generated_local_secret
EMAIL_MODE=local
EMAIL_FROM="BuyTrail <no-reply@buytrail.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=buytrail-private
OBJECT_STORAGE_ACCESS_KEY=local_only
OBJECT_STORAGE_SECRET_KEY=local_only_object_secret
LIVE_PROVIDERS_ENABLED=false
AI_FEATURES_ENABLED=false
REAL_RECEIPT_UPLOADS_ENABLED=false
# Comma-separated emails auto-granted admin on sign-in (local only).
ADMIN_EMAILS=admin@buytrail.local
# Honour X-Forwarded-For for rate limiting only behind a trusted reverse proxy.
TRUST_PROXY=false
