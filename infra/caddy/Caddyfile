# Caddy obtains and renews a Let's Encrypt certificate for {$SITE_DOMAIN} automatically.
# Requirements: a DNS A record pointing the domain at this server, and ports 80/443 open.
{$SITE_DOMAIN} {
	encode zstd gzip
	# Cap request bodies (receipts are ≤10 MiB; JSON far less).
	request_body {
		max_size 12MB
	}
	reverse_proxy web:3000 {
		# Overwrite (not append) the client IP header so the app can trust it (TRUST_PROXY=true).
		header_up X-Forwarded-For {remote_host}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
