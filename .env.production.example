# BuyTrail public demo (operating level D0). Copy to .env.production on the server and fill in.
# Generate each secret with:  openssl rand -hex 32
# NEVER commit .env.production.

# ── Site ──────────────────────────────────────────────────────────────────────────────
APP_MODE=demo
SITE_DOMAIN=buytrail.example.com
APP_BASE_URL=https://buytrail.example.com
# Caddy overwrites X-Forwarded-For, so the app can use it for rate limiting.
TRUST_PROXY=true

# ── Secrets (generate fresh values; do not reuse the local ones) ──────────────────────────
AUTH_SECRET=
POSTGRES_PASSWORD=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=buytrail-private

# ── Email (SMTP from your provider, e.g. Resend / Postmark / Amazon SES) ─────────────────
EMAIL_MODE=smtp
EMAIL_FROM="BuyTrail demo <demo@buytrail.example.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
# Only these addresses (or @domain entries) receive sign-in links and alert emails.
SIGNIN_ALLOWLIST=you@example.com
EMAIL_TEST_ALLOWLIST=you@example.com
# Becomes an administrator on first sign-in (demo/local modes only).
ADMIN_EMAILS=you@example.com

# ── Feature flags (keep as-is for the demo) ──────────────────────────────────────────────
# true adds real Google Shopping prices (via SerpApi) for a curated catalog next to the sample data.
LIVE_PROVIDERS_ENABLED=false
# Required when LIVE_PROVIDERS_ENABLED=true. Add on the server only; never commit it.
# SERPAPI_API_KEY=
# Each tracked product is re-searched every N hours (1 credit per search). Caps are hard limits.
SERPAPI_REFRESH_HOURS=72
SERPAPI_DAILY_BUDGET=6
SERPAPI_MONTHLY_BUDGET=200
AI_FEATURES_ENABLED=false
REAL_RECEIPT_UPLOADS_ENABLED=false
